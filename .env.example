# Copy to .env and fill in only what you actually use. Nothing here is required
# for the self-test — every value has a free tier and a sensible default.

# Script generation (core/scriptgen.py), only used when script.mode: generate.
OLLAMA_HOST=http://127.0.0.1:11434
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Durable output sync (iolib/drive.py). Unset = no sync outside outputs/.
PRESENTER_DRIVE_DIR=

# Weights cache location (defaults to ./weights). Point at Drive on Colab to
# avoid re-downloading multi-GB checkpoints every session.
PRESENTER_WEIGHTS_DIR=

# Override which interpreter runs a stage (core/envs.py). Normally unset —
# only needed on Colab, where one runtime plays every stage's role.
# PRESENTER_VOICE_PYTHON=
# PRESENTER_LIPSYNC_PYTHON=
# PRESENTER_CAPTIONS_PYTHON=
